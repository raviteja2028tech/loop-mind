# Copy to `.env` at the repo root (pydantic-settings reads `.env` from the
# process's working directory, i.e. wherever uvicorn is launched from).
APP_NAME=LOOP-MIND API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./databases/sqlite/loop_mind.db
JWT_SECRET_KEY=change-me-in-production-to-a-random-32-byte-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Optional integrations (leave empty to run without them) -------------
# Gemini key for the LangChain agents (AI services/agents/llm.py). Without it
# every agent runs its deterministic fallback.
GOOGLE_API_KEY=
# SMTP mailbox for interview invitations. Empty => the Email Agent reports
# "not configured" instead of faking a send.
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=
# LinkedIn OAuth (profile import)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5180/linkedin/oauth-callback
